#include <stdio.h>
#include <math.h>

/* Navy formulas (输入单位：厘米)
   男性:  BF% = 86.010 * log10(waist - neck) - 70.041 * log10(height) + 36.76
   女性:  BF% = 163.205 * log10(waist + hip - neck) - 97.684 * log10(height) - 78.387
*/

/* Deurenberg (基于 BMI)
   BF% = 1.2 * BMI + 0.23 * age - 10.8 * sex - 5.4
   sex: 男性 = 1, 女性 = 0
*/

double bf_navy_male(double height_cm, double neck_cm, double waist_cm) {
    if (waist_cm <= neck_cm || height_cm <= 0) return -1.0;
    return 86.010 * log10(waist_cm - neck_cm) - 70.041 * log10(height_cm) + 36.76;
}

double bf_navy_female(double height_cm, double neck_cm, double waist_cm, double hip_cm) {
    if ((waist_cm + hip_cm) <= neck_cm || height_cm <= 0) return -1.0;
    return 163.205 * log10(waist_cm + hip_cm - neck_cm) - 97.684 * log10(height_cm) - 78.387;
}

double bf_deurenberg(double weight_kg, double height_cm, int age, int is_male) {
    double h_m = height_cm / 100.0;
    if (h_m <= 0) return -1.0;
    double bmi = weight_kg / (h_m * h_m);
    return 1.2 * bmi + 0.23 * age - 10.8 * is_male - 5.4;
}

int main(void) {
    int choice;
    printf("请选择计算方法：\n");
    printf("1) 美国海军公式 (Navy method)\n");
    printf("2) 基于 BMI 的 Deurenberg 公式\n");
    printf("输入 1 或 2: ");
    if (scanf("%d", &choice) != 1) {
        printf("输入无效。\n");
        return 1;
    }

    if (choice == 1) {
        int sex;
        printf("请输入性别 (0 = 女, 1 = 男): ");
        if (scanf("%d", &sex) != 1 || (sex != 0 && sex != 1)) {
            printf("性别输入无效。\n");
            return 1;
        }

        double height, neck, waist, hip = 0.0;
        printf("身高 (cm): ");
        if (scanf("%lf", &height) != 1 || height <= 0) { printf("身高无效。\n"); return 1; }
        printf("颈围 (cm): ");
        if (scanf("%lf", &neck) != 1 || neck <= 0) { printf("颈围无效。\n"); return 1; }
        printf("腰围 (cm): ");
        if (scanf("%lf", &waist) != 1 || waist <= 0) { printf("腰围无效。\n"); return 1; }
        if (sex == 0) {
            printf("臀围 (cm): ");
            if (scanf("%lf", &hip) != 1 || hip <= 0) { printf("臀围无效。\n"); return 1; }
            double bf = bf_navy_female(height, neck, waist, hip);
            if (bf < 0) { printf("输入的围度不满足计算要求。\n"); return 1; }
            printf("估算体脂率 (Navy, 女性): %.2f%%\n", bf);
        } else {
            double bf = bf_navy_male(height, neck, waist);
            if (bf < 0) { printf("输入的围度不满足计算要求。\n"); return 1; }
            printf("估算体脂率 (Navy, 男性): %.2f%%\n", bf);
        }
    } else if (choice == 2) {
        int sex;
        printf("请输入性别 (0 = 女, 1 = 男): ");
        if (scanf("%d", &sex) != 1 || (sex != 0 && sex != 1)) {
            printf("性别输入无效。\n");
            return 1;
        }
        double weight, height;
        int age;
        printf("体重 (kg): ");
        if (scanf("%lf", &weight) != 1 || weight <= 0) { printf("体重无效。\n"); return 1; }
        printf("身高 (cm): ");
        if (scanf("%lf", &height) != 1 || height <= 0) { printf("身高无效。\n"); return 1; }
        printf("年龄 (岁): ");
        if (scanf("%d", &age) != 1 || age < 0) { printf("年龄无效。\n"); return 1; }

        double bf = bf_deurenberg(weight, height, age, sex);
        printf("估算体脂率 (Deurenberg): %.2f%%\n", bf);
    } else {
        printf("选项无效。\n");
        return 1;
    }

    return 0;
}
